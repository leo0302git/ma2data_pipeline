# Allow only pipeline source, source documentation, and approved configuration.
/*
!/.gitignore
!/.pipeline-project.json
!/config/
/config/*
!/config/accounts.successor.example.json
!/config/proxy/
/config/proxy/*
!/config/proxy/proxy.example.json

!/task_generate_pipeline/
/task_generate_pipeline/*
!/task_generate_pipeline/*.py
!/task_generate_pipeline/*.md
!/task_generate_pipeline/accounts.example.json
!/task_generate_pipeline/RELEASE_MANIFEST.json
!/task_generate_pipeline/VERSION.json

!/task_generate_pipeline/runtime-images/
/task_generate_pipeline/runtime-images/*
!/task_generate_pipeline/runtime-images/Dockerfile.*

!/task_generate_pipeline/tests/
/task_generate_pipeline/tests/*
!/task_generate_pipeline/tests/test_*.py

!/task_generate_pipeline/skills/
/task_generate_pipeline/skills/**
!/task_generate_pipeline/skills/**/
!/task_generate_pipeline/skills/**/*.md

!/task_generate_pipeline/vendor/
/task_generate_pipeline/vendor/**
!/task_generate_pipeline/vendor/**/
!/task_generate_pipeline/vendor/**/*.py
!/task_generate_pipeline/vendor/**/*.md
!/task_generate_pipeline/vendor/**/.gitattributes
!/task_generate_pipeline/vendor/naturegym/ADDED_REFERENCE_GUIDES.json
!/task_generate_pipeline/vendor/naturegym/.agents/skills/task-build/templates/metadata.json
!/task_generate_pipeline/vendor/naturegym/.agents/skills/task-build/templates/packages.json
!/task_generate_pipeline/vendor/naturegym/.agents/skills/task-build/templates/rubric.json
!/task_generate_pipeline/vendor/naturegym/.agents/skills/task-build/templates/task.json
!/task_generate_pipeline/vendor/naturegym/.agents/skills/task-build/templates/task.source.toml

# Ignore generated files and local secrets even inside allowed source directories.
**/__pycache__/
**/.env*
**/seed_catalog.json
**/group_seed_bindings.json
